rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write only if request is from authenticated user
    match /receipts/{receiptId} {
      allow read, write: if request.auth != null;
    }
    
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    
    match /paymentHistory/{paymentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.saleId is string
        && request.resource.data.amount is number
        && request.resource.data.paymentMethod is string
        && request.resource.data.date is string;
      allow update, delete: if false; // Prevent updates and deletes
    }
    
    match /suppliers/{supplierId} {
      allow read, write: if request.auth != null;
    }
    
    match /supplierPayments/{paymentId} {
      allow read, write: if request.auth != null;
    }
    
    match /supplierProducts/{productId} {
      allow read, write: if request.auth != null;
    }
  }
} 